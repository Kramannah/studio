rules_version = '2';

// --- STORAGE SECURITY POLICIES V14 ---
// Updated to allow authenticated owners AND authorized managers to write to coverage paths.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to identify administrative/managerial accounts
    function isManagerial() {
      return request.auth != null && (
        request.auth.token.email.lower() in [
          "mbustamante@hovidinc.com", 
          "admin@hovidinc.com", 
          "wbmaralit@hovidinc.com",
          "lsldsm@hovidinc.com",
          "gmasdsm@hovidinc.com",
          "mnldsm@hovidinc.com",
          "visdsm@hovidinc.com",
          "cldsm@hosm.com",
          "mindsm@hovidinc.com",
          "nldsm@hovidinc.com"
        ]
      );
    }

    // Proof of Coverage & Signatures
    // Permitted if the user owns the folder OR is a manager.
    match /coverage/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isManagerial());
    }
    
    match /signatures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isManagerial());
    }

    // System configurations and templates
    match /system/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isManagerial();
    }
  }
}