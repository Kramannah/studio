rules_version = '2';

// --- STORAGE SECURITY POLICIES V6 ---
// Updated: 2024-05-21
// Simplified policy to ensure reliable field uploads across all territories.

service firebase.storage {
  match /b/{bucket}/o {
    // Universal access for authenticated field personnel to prevent path-matching errors
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
