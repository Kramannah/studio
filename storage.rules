rules_version = '2';

// --- STORAGE SECURITY POLICIES V17 ---
// Structural update: Separated write rules for the coverage path to ensure 
// that UID-matching authorization is evaluated independently from the 
// managerial check.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to identify administrative/managerial accounts
    function isManagerial() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email.lower() in [
               "mbustamante@hovidinc.com", 
               "admin@hovidinc.com", 
               "wbmaralit@hovidinc.com",
               "lsldsm@hovidinc.com",
               "gmasdsm@hovidinc.com",
               "mnldsm@hovidinc.com",
               "visdsm@hovidinc.com", 
               "cldsm@hosm.com",
               "mindsm@hovidinc.com",
               "nldsm@hovidinc.com"
             ];
    }

    // Proof of Coverage
    match /coverage/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      // Rule 1: Authorize the folder owner (independent)
      allow write: if request.auth != null && request.auth.uid == userId;
      // Rule 2: Authorize managers (independent)
      allow write: if isManagerial();
    }
    
    // Signatures
    match /signatures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isManagerial());
    }

    // System configurations and templates
    match /system/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isManagerial();
    }
  }
}
