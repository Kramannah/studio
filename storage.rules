rules_version = '2';

// --- STORAGE SECURITY POLICIES V16 ---
// Fixed storage/unauthorized by using wildcard bucket matching and UID path sandboxing.

service firebase.storage {
  match /b/{bucket}/o {
    // Explicit rule for Proof of Coverage photos
    // Only the authenticated owner of the folder can write to it.
    match /coverage/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Explicit rule for Signatures (Doctor/Joint)
    match /signatures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback for organizational assets (Admin only)
    match /system/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.token.email.toLower() in [
          "mbustamante@hovidinc.com", 
          "admin@hovidinc.com", 
          "wbmaralit@hovidinc.com"
        ]);
    }
  }
}