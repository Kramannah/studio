rules_version = '2';

// --- STORAGE SECURITY POLICIES V11 ---
// Simplified authenticated access to resolve persistent 'storage/unauthorized' errors.
// This allows any logged-in representative to upload and manage their report files.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read/write access if the user is authenticated.
      // This is the most resilient pattern for field personnel using fluctuating mobile signals.
      allow read, write: if request.auth != null;
    }
  }
}
