rules_version = '2';

// --- STORAGE SECURITY POLICIES V14 ---
// Explicit bucket mapping for maximum reliability.

service firebase.storage {
  match /b/hovidcoverage.firebasestorage.app/o {
    match /{allPaths=**} {
      // Allow read/write access to any logged-in representative.
      // This is the most resilient rule for field teams.
      allow read, write: if request.auth != null;
    }
  }
  
  // Fallback for default bucket naming conventions
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}