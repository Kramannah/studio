rules_version = '2';

// --- STORAGE SECURITY POLICIES V7 ---
// Updated: 2024-05-22
// Maximum simplified policy to resolve 'storage/unauthorized' errors.

service firebase.storage {
  match /b/{bucket}/o {
    // Allow any authenticated user to read and write any path.
    // This is the most resilient policy for high-volume field reporting.
    allow read, write: if request.auth != null;
  }
}
