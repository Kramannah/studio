rules_version = '2';

// --- STORAGE SECURITY POLICIES V4 ---
// Updated: 2024-04-18
// Standardizing access to ensure background sync resilience across all territories.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow any authenticated user to read/write to their own folders
    // Using a global match to handle background sync reliably across sessions
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
