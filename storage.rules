rules_version = '2';

// --- STORAGE SECURITY POLICIES V3 ---
// Simplified rules to resolve authentication propagation issues during sync.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow any authenticated user to read/write to their own folders
    // Using a simplified match to ensure background sync reliability
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
