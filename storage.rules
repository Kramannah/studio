rules_version = '2';

// --- STORAGE SECURITY POLICIES V10 ---
// Force-pushing global authenticated access to resolve 'storage/unauthorized'
// This ensures field reporting is never interrupted by path-matching latencies.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow any authenticated user to read and write any path.
      allow read, write: if request.auth != null;
    }
  }
}
