rules_version = '2';

// --- STORAGE SECURITY POLICIES V12 ---
// Ultra-simplified authenticated access. 
// This version uses a flattened rule structure to ensure the Storage backend 
// correctly resolves 'request.auth' during fluctuating mobile signals.

service firebase.storage {
  match /b/{bucket}/o {
    // Top-level permission check for all folders
    match /{allPaths=**} {
      // Allow read/write access to any logged-in representative.
      // We rely on Firestore Security Rules for row-level report security.
      allow read, write: if request.auth != null;
    }
  }
}
