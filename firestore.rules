
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Core Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Ultra-Fast Ownership Check
    function isOwner(docUserId) {
      return isSignedIn() && docUserId == request.auth.uid;
    }

    // Role-based check (Requester-centric for query compatibility)
    function isManagerial() {
      if (!isSignedIn()) return false;
      
      // Admin & DSM Whitelist (Direct resolution for provisioned accounts)
      let email = request.auth.token.email;
      let authorizedEmails = [
        "mbustamante@hovidinc.com", 
        "admin@hovidinc.com", 
        "wbmaralit@hovidinc.com",
        "lsldsm@hovidinc.com",
        "gmasdsm@hovidinc.com",
        "mnldsm@hovidinc.com",
        "visdsm@hovidinc.com",
        "cldsm@hovidinc.com",
        "mindsm@hovidinc.com",
        "nldsm@hovidinc.com"
      ];
      
      // Use toLower() instead of lower()
      if (email != null && email.toLower() in authorizedEmails) return true;
      
      // Explicit UID whitelist to ensure managers can perform approvals immediately
      let authorizedUids = [
        "SgOR5cjCC6dZ0oABv4nXdntu6pI3", // Admin
        "m2ZTNUi5v9ef82FxVRbwSmyGv9S2", // Admin
        "SO4jVY3fTwgHAkF0Ysi57phPCyn1", // Cabangon (LSL)
        "v0OiwmjES5ffpntunx4S6x92FC32", // Daquioag (GMAS)
        "OU7hbPEFg7gaYfg1qHFOjNpBJLe2", // Gonzales (MNL)
        "qQULNmXLYSfC8x3G6UuGKjZrimh2", // Ignacio (VIS)
        "Z21R5NunJ2aD6wEKNOMPCzWWmzA2", // Langit (CL)
        "mXMrQ6B740TNeC5a1LBDosCa14J2", // Ligutom (MIN)
        "1qQzrIyR2POzuITWF4p8MIfwmfk1"  // Nonato (NL)
      ];
      if (request.auth.uid in authorizedUids) return true;
      
      // Profile lookup for dynamic roles (Fallback)
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(profilePath) && (
        get(profilePath).data.get('role', 'PMR') in ["Admin", "Manager", "Marketing", "HR"]
      );
    }

    // Token-based whitelist check for specific PMRs with extra access
    function isSpecialAuthorizedPMR() {
      if (!isSignedIn()) return false;
      let email = request.auth.token.email;
      return email != null && email.toLower() in ["kgpangan@hovidinc.com", "pjramos@hovidinc.com"];
    }

    // --- Collection Rules ---

    match /coverageEntries/{id} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSpecialAuthorizedPMR() || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /doctors/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /plans/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /nonCallDays/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isManagerial() || isOwner(resource.data.userId);
      allow delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /planningRequests/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isManagerial() || isOwner(resource.data.userId);
      allow delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /timeLogs/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial();
    }

    match /marketingSamples/{id} {
      allow read, list: if isSignedIn();
      allow write: if isManagerial();
    }

    match /individualAllocations/{id} {
      allow read, list: if isSignedIn();
      allow write: if isManagerial();
    }
    
    match /userProfiles/{id} {
      allow read: if isSignedIn() && (request.auth.uid == id || isManagerial());
      allow write: if isSignedIn() && (request.auth.uid == id || isManagerial());
      allow list: if isSignedIn() && isManagerial();
    }
  }
}
