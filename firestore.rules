
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Core Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(docUserId) {
      return isSignedIn() && docUserId == request.auth.uid;
    }

    // Robust Administrative Check using standard logic chain
    // Refactored to prevent circular dependencies and handle null tokens gracefully
    function isManagerial() {
      return isSignedIn() && (
        // 1. Explicit UID whitelist (Checked first to avoid recursion for Super Admins)
        (request.auth.uid in [
          "SgOR5cjCC6dZ0oABv4nXdntu6pI3", // Admin (mbustamante)
          "m2ZTNUi5v9ef82FxVRbwSmyGv9S2", // Admin
          "SO4jVY3fTwgHAkF0Ysi57phPCyn1", // DSM
          "v0OiwmjES5ffpntunx4S6x92FC32", // DSM
          "OU7hbPEFg7gaYfg1qHFOjNpBJLe2", // DSM
          "qQULNmXLYSfC8x3G6UuGKjZrimh2", // DSM
          "Z21R5NunJ2aD6wEKNOMPCzWWmzA2", // DSM
          "mXMrQ6B740TNeC5a1LBDosCa14J2", // DSM
          "1qQzrIyR2POzuITWF4p8MIfwmfk1"  // DSM
        ]) ||
        // 2. Email Whitelist (Handled with null safety)
        (request.auth.token.email != null && request.auth.token.email.toLower() in [
          "mbustamante@hovidinc.com", 
          "admin@hovidinc.com", 
          "wbmaralit@hovidinc.com",
          "lsldsm@hovidinc.com",
          "gmasdsm@hovidinc.com",
          "mnldsm@hovidinc.com",
          "visdsm@hovidinc.com",
          "cldsm@hovidinc.com",
          "mindsm@hovidinc.com",
          "nldsm@hovidinc.com"
        ]) ||
        // 3. Profile-based dynamic role check
        // Only attempted if not already verified by hardcoded lists
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role in ["Admin", "Manager", "Marketing", "HR"])
      );
    }

    match /coverageEntries/{id} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /doctors/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /plans/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /nonCallDays/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /planningRequests/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial() || isOwner(resource.data.userId);
    }

    match /timeLogs/{id} {
      allow read, list: if isSignedIn() && (isOwner(resource.data.userId) || isManagerial());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isManagerial();
    }

    match /marketingSamples/{id} {
      allow read, list: if isSignedIn();
      allow write: if isManagerial();
    }

    match /individualAllocations/{id} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isManagerial());
      allow write: if isManagerial();
    }
    
    match /userProfiles/{id} {
      allow read: if isSignedIn() && (request.auth.uid == id || isManagerial());
      allow write: if isSignedIn() && (request.auth.uid == id || isManagerial());
      allow list: if isSignedIn() && isManagerial();
    }
  }
}
